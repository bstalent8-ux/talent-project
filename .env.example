# Copy to .env.local and fill in. Never commit real values.
#
# NEXT_PUBLIC_* are inlined into the client bundle at build time — they must be
# present when `next build` runs (locally, in CI, and as Docker build args).
# Everything else is read at request time on the server only.

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses RLS — never expose to the client, never pass as a
# Docker build arg (build args are stored in the image history).
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudinary (unsigned upload preset, proxied through our API routes) ──────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
NEXT_PUBLIC_CLOUDINARY_FOLDER=talents

# ── Optional ─────────────────────────────────────────────────────────────────
# Public support number for the WhatsApp CTA. Falls back to a placeholder
# (966500000000) when unset — set it before launch.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Cloudflare Turnstile (CAPTCHA on the public contact / support forms).
# Unset = the widget renders nothing and lib/turnstile.ts's verifyTurnstile()
# passes everyone — forms still work, protected only by the honeypot + the
# rate limiter (lib/rate-limit.ts, always on). Set BOTH to switch it on:
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Contact-form notification email. Delivery is skipped unless RESEND_API_KEY
# is also set.
CONTACT_EMAIL=
RESEND_API_KEY=

# Meta/Facebook Ads Pixel. Unset = components/analytics/MetaPixel.tsx renders
# nothing and lib/analytics/meta-pixel.ts's trackMetaEvent() no-ops — the
# in-house tracker (lib/events/, /admin/user-activity) works independently of
# this.
NEXT_PUBLIC_META_PIXEL_ID=

# ── Admin health checkup (/admin/health-check) — server only, all optional ──
# Cloudinary Admin API (usage/storage report). Distinct from the
# NEXT_PUBLIC_CLOUDINARY_* unsigned-upload vars above, which grant no read
# access. Get these from Cloudinary's dashboard, not the upload preset.
# Unset = the Cloudinary section of the checkup shows "not configured".
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Anthropic API key for the checkup's "AI Recommendations" section. Unset =
# that section shows "not enabled" instead of erroring.
ANTHROPIC_API_KEY=
