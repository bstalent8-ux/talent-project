{
  "name": "talents-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:schema-audit": "node scripts/schema-audit.mjs",
    "test:e2e": "node tests/e2e/me-role.test.mjs && node tests/e2e/cache.test.mjs && node tests/e2e/explore.test.mjs && node tests/e2e/guest-permissions.test.mjs",
    "test:e2e:guest": "node tests/e2e/guest-permissions.test.mjs",
    "pages:build": "npx @cloudflare/next-on-pages@1",
    "pages:deploy": "wrangler pages deploy .vercel/output/static --project-name=talents-platform --branch=main",
    "deploy": "npm run pages:build && npm run pages:deploy"
  },
  "dependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.2",
    "@swc/helpers": "0.5.23",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.42.0",
    "lucide-react": "^1.21.0",
    "next": "15.3.4",
    "next-intl": "^4.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
